{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ingredient-catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ingredients"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "aliases"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          }
        }
      }
    }
  }
}
