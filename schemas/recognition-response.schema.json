{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "recognition-response",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "requestId",
        "status",
        "suggestions"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "status": {
          "const": "success"
        },
        "suggestions": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "ingredientId",
                  "uncertain",
                  "evidence"
                ],
                "properties": {
                  "kind": {
                    "const": "catalog"
                  },
                  "ingredientId": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
                  },
                  "uncertain": {
                    "type": "boolean"
                  },
                  "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "$ref": "#/$defs/evidence"
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "suggestedName",
                  "evidence"
                ],
                "properties": {
                  "kind": {
                    "const": "free_text"
                  },
                  "suggestedName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "$ref": "#/$defs/evidence"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "requestId",
        "status",
        "code",
        "retryable"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "requestId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "status": {
          "const": "error"
        },
        "code": {
          "enum": [
            "invalid_request",
            "unsupported_image",
            "upload_limit",
            "rate_limited",
            "timeout",
            "provider_unavailable",
            "invalid_provider_output"
          ]
        },
        "retryable": {
          "type": "boolean"
        }
      }
    }
  ],
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "imageId",
        "clue"
      ],
      "properties": {
        "imageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "clue": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    }
  }
}
