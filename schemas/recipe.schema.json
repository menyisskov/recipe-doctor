{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "description",
    "preparationMinutes",
    "servings",
    "requiredIngredients",
    "optionalIngredients",
    "equipment",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 350
    },
    "preparationMinutes": {
      "type": "integer",
      "minimum": 1
    },
    "servings": {
      "type": "integer",
      "minimum": 1
    },
    "requiredIngredients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ingredientId",
          "amount",
          "unit",
          "substitutions"
        ],
        "properties": {
          "ingredientId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unit": {
            "enum": [
              "piece",
              "clove",
              "pinch",
              "tsp",
              "tbsp",
              "cup",
              "g",
              "kg",
              "ml",
              "l"
            ]
          },
          "substitutions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ingredientId",
                "amount",
                "unit",
                "usageNote"
              ],
              "properties": {
                "ingredientId": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
                },
                "amount": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit": {
                  "enum": [
                    "piece",
                    "clove",
                    "pinch",
                    "tsp",
                    "tbsp",
                    "cup",
                    "g",
                    "kg",
                    "ml",
                    "l"
                  ]
                },
                "usageNote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              }
            }
          }
        }
      }
    },
    "optionalIngredients": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ingredientId",
          "amount",
          "unit"
        ],
        "properties": {
          "ingredientId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unit": {
            "enum": [
              "piece",
              "clove",
              "pinch",
              "tsp",
              "tbsp",
              "cup",
              "g",
              "kg",
              "ml",
              "l"
            ]
          }
        }
      }
    },
    "equipment": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instruction",
          "ingredientIds"
        ],
        "properties": {
          "instruction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "ingredientIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
            }
          }
        }
      }
    }
  }
}
