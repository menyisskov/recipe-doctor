{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pantry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "confirmedIngredientIds",
    "stapleIngredientIds",
    "freeTextItems"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "confirmedIngredientIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
      }
    },
    "stapleIngredientIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
      }
    },
    "freeTextItems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      }
    }
  }
}
